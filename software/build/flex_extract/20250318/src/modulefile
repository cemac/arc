#%Module -*- tcl -*-

set module_name XAPP_NAMEX
set module_version XAPP_VERSIONX
set module_build XBUILD_VERSIONX
set module_flavour XFLAVOURX

set module_root $::env(CEMAC_SOFTWARE)/apps/$module_name/$module_version/$module_build/$module_flavour

conflict XAPP_NAMEX

proc ModulesHelp { } {
  puts stderr "
    Retrieve ECMWF data for FLEXPART input

    flex_extract is a software package to support retrieving meteorological
    fields from the European Centre for Medium-Range Weather Forecasts' (ECMWF)
    Meteorological Archival and Retrieval System (MARS) as input for the
    FLEXTRA/FLEXPART Atmospheric Transport Modelling system.

    Homepage: https://flexpart.img.univie.ac.at/flexextract/
  "
}

module-whatis "Retrieve ECMWF data for FLEXPART input"

prepend-path PATH $module_root/bin

setenv FLEX_EXTRACT_HOME $module_root
