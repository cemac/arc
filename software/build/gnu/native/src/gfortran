#!/bin/bash

__GFORTRAN='XGFORTRANX'
__ARGS=()
__INCS=()

while [ ! -z "${1}" ]
do
  if [ "${1}" = "-I" ] ; then
    __INCS+=("${1}${2}")
    shift
    shift
    continue
  elif [[ "${1}" =~ ^-I ]] ; then
    __INCS+=("${1}")
    shift
    continue
  else
    __ARGS+=("${1}")
  fi
  shift
done

for __CPATH in ${CPATH//:/ }
do
  __INCS+=("-I${__CPATH}")
done

exec ${__GFORTRAN} "${__INCS[@]}" "${__ARGS[@]}"
