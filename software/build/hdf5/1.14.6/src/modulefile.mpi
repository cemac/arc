#%Module -*- tcl -*-

set module_name XAPP_NAMEX
set module_version XAPP_VERSIONX
set module_build XBUILD_VERSIONX
set module_flavour XFLAVOURX

set module_root $::env(CEMAC_SOFTWARE)/libraries/$module_name/$module_version/$module_build/$module_flavour

proc ModulesHelp { } {
  puts stderr "
    HDF5 data format library

    Homepage: http://www.hdfgroup.org/HDF5/
  "
}

module-whatis "HDF5 data format library"

prepend-path PATH $module_root/bin
prepend-path CPATH $module_root/include
prepend-path LIBRARY_PATH $module_root/lib
prepend-path LD_LIBRARY_PATH $module_root/lib
prepend-path PKG_CONFIG_PATH $module_root/lib/pkgconfig
prepend-path CMAKE_PREFIX_PATH $module_root/

setenv HDF5_HOME $module_root

if { [module-info mode load] } {
  if { [module-info shell bash] } {
    puts stdout "_MY_LMFILE=\"$ModulesCurrentModulefile\" ; export _MY_LMFILE"
    puts stdout "_LMFILES_=\"\${_LMFILES_/:\${_MY_LMFILE//\//\\\\/}/}:\${_MY_LMFILE}\" ; export _LMFILES_"
    puts stdout "_MY_MODULE=\"$module_name\/$module_version\" ; export _MY_MODULE"
    puts stdout "LOADEDMODULES=\"\${LOADEDMODULES/:\${_MY_MODULE//\//\\\\/}/}:\${_MY_MODULE}\" ; export LOADEDMODULES"
    puts stdout "unset _MY_LMFILE _MY_MODULE"
  }
}

if { [module-info command] != "purge" } {
  prereq XPREREQX
}
