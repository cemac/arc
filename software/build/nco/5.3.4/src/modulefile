#%Module -*- tcl -*-

set module_name XAPP_NAMEX
set module_version XAPP_VERSIONX
set module_build XBUILD_VERSIONX
set module_flavour XFLAVOURX

set module_root $::env(CEMAC_SOFTWARE)/apps/$module_name/$module_version/$module_build/$module_flavour

conflict XAPP_NAMEX

proc ModulesHelp { } {
  puts stderr "
    netCDF Operators

    The NCO toolkit manipulates and analyzes data stored in netCDF-accessible
    formats, including DAP, HDF4, and HDF5.

    Homepage: https://nco.sourceforge.net/
  "
}

module-whatis "netCDF Operators"

prepend-path PATH $module_root/bin

setenv NCO_HOME $module_root
