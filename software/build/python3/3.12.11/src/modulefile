#%Module -*- tcl -*-

set module_name XAPP_NAMEX
set module_version XAPP_VERSIONX
set module_build XBUILD_VERSIONX
set module_flavour XFLAVOURX

set module_root $::env(CEMAC_SOFTWARE)/compilers/$module_name/$module_version/$module_build/$module_flavour

proc ModulesHelp { } {
  puts stderr "
    Anaconda Python3 environment

    Includes matplotlib, numpy, scipy, etc.
  "
}

module-whatis "Anaconda Python3 environment"

family python

prepend-path PATH $module_root/bin

setenv PYTHON3_HOME $module_root
setenv PYTHON_HOME $module_root/conda
