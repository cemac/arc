#%Module -*- tcl -*-

set module_name XAPP_NAMEX
set module_version XAPP_VERSIONX
set module_build XBUILD_VERSIONX
set module_flavour XFLAVOURX

set module_root $::env(CEMAC_SOFTWARE)/libraries/$module_name/$module_version/$module_build/$module_flavour

conflict XAPP_NAMEX

proc ModulesHelp { } {
  puts stderr "
    The XIOS (Xml I/O Server) library is based on client-server principles
    where the server manages the outputs asynchronously from the client (the
    climate model) so that the bottleneck of writing data is alleviated.

    Homepage: https://lmdz-forge.lmd.jussieu.fr/mediawiki/Planets/index.php/The_XIOS_Library
  "
}

module-whatis "Xml I/O Server library"

prepend-path PATH $module_root/bin
prepend-path CPATH $module_root/include
prepend-path LIBRARY_PATH $module_root/lib
prepend-path CMAKE_PREFIX_PATH $module_root/

setenv XIOS_HOME $module_root

if { [module-info command] != "purge" } {
  prereq XPREREQX
}
