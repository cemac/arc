#%Module -*- tcl -*-

set module_name R
set module_version 4.3.3
set module_build 1
set module_flavour default

set module_root $::env(CEMAC_SOFTWARE)/apps/$module_name/$module_version/$module_build/$module_flavour

proc ModulesHelp { } {
  puts stderr "
    Statistical computing and graphics

    Homepage : https://www.r-project.org/
  "
}

module-whatis "Statistical computing and graphics"

prepend-path PATH $module_root/bin

setenv R_HOME $module_root
