#%Module -*- tcl -*-

set module_name ncl
set module_version 6.6.2
set module_build 1
set module_flavour default

set module_root $::env(CEMAC_SOFTWARE)/apps/$module_name/$module_version/$module_build/$module_flavour

conflict ncl

proc ModulesHelp { } {
  puts stderr "
    NCAR Command Language

    NCL has robust file input and output. It can read and   write netCDF-3,
    netCDF-4 classic, netCDF-4, HDF4, binary,  and ASCII data. It can read
    HDF-EOS2, HDF-EOS5, GRIB1,  GRIB2, and OGR files (shapefiles, MapInfo, GMT,
    Tiger). 

    Homepage : https://www.ncl.ucar.edu/
  "
}

module-whatis "NCAR Command Language"

prepend-path PATH $module_root/bin

setenv NCL_HOME $module_root
