#%Module -*- tcl -*-

set module_name ncview
set module_version 2.1.11
set module_build 1
set module_flavour default

set module_root $::env(CEMAC_SOFTWARE)/apps/$module_name/$module_version/$module_build/$module_flavour

conflict ncview

proc ModulesHelp { } {
  puts stderr "
    Visual browser for netCDF format files

    Homepage: https://cirrus.ucsd.edu/ncview/
  "
}

module-whatis "Visual browser for netCDF format files"

prepend-path PATH $module_root/bin

setenv NCVIEW_HOME $module_root
