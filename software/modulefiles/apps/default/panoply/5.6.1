#%Module -*- tcl -*-

set module_name panoply
set module_version 5.6.1
set module_build 1
set module_flavour default

set module_root $::env(CEMAC_SOFTWARE)/apps/$module_name/$module_version/$module_build/$module_flavour

conflict panoply

proc ModulesHelp { } {
  puts stderr "
    Panoply is a cross-platform application that plots geo-gridded and other
    arrays from netCDF, HDF, GRIB, and other datasets.

    Homepage : http://www.giss.nasa.gov/tools/panoply/
  "
}

module-whatis "NetCDF, HDF and GRIB Data Viewer"

prepend-path PATH $module_root/bin

setenv PANOPLY_HOME $module_root
