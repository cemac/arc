#%Module -*- tcl -*-

set module_name patchelf
set module_version 0.18.0
set module_build 1
set module_flavour default

set module_root $::env(CEMAC_SOFTWARE)/apps/$module_name/$module_version/$module_build/$module_flavour

conflict patchelf

proc ModulesHelp { } {
  puts stderr "
    PatchELF is a simple utility for modifying existing ELF executables and libraries.

    Homepage: https://github.com/NixOS/patchelf/
  "
}

module-whatis "Modify ELF executables and libraries"

prepend-path PATH $module_root/bin

setenv PATCHELF_HOME $module_root
