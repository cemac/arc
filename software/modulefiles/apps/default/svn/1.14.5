#%Module -*- tcl -*-

set module_name svn
set module_version 1.14.5
set module_build 1
set module_flavour default

set module_root $::env(CEMAC_SOFTWARE)/apps/$module_name/$module_version/$module_build/$module_flavour

proc ModulesHelp { } {
  puts stderr "
    Subversion version control

    Homepage: https://subversion.apache.org/
  "
}

module-whatis "Subversion version control"

prepend-path PATH $module_root/bin
prepend-path MANPATH $module_root/share/man

setenv SVN_HOME $module_root
