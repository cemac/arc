#%Module -*- tcl -*-

set module_name gnu
set module_version native
set module_build 1
set module_flavour default

set module_root $::env(CEMAC_SOFTWARE)/compilers/$module_name/$module_version/$module_build/$module_flavour
set module_apps $::env(CEMAC_SOFTWARE)/modulefiles/apps/$module_name-$module_version
set module_libraries $::env(CEMAC_SOFTWARE)/modulefiles/libraries/$module_name-$module_version

proc ModulesHelp { } {
  puts stderr "
    GNU GCC compiler suite

    Homepage: https://gcc.gnu.org/
  "
}

module-whatis "GNU GCC compiler suite"

family compiler

prepend-path PATH $module_root/bin
prepend-path LD_LIBRARY_PATH $module_root/lib
prepend-path LD_LIBRARY_PATH $module_root/lib64
prepend-path CMAKE_PREFIX_PATH $module_root/
prepend-path MANPATH $module_root/share/man
prepend-path MODULEPATH $module_apps
prepend-path MODULEPATH $module_libraries

setenv GNU_HOME $module_root
setenv CC gcc
setenv CXX g++
setenv FC gfortran
setenv F77 gfortran
setenv F90 gfortran

if { [module-info mode load] } {
  module save cemac-modules
  module purge
  module restore cemac-modules
}

if { [module-info mode unload] } {
  module unuse $module_apps
  module unuse $module_libraries
}

if { [module-info mode unload] &&
     [module-info command] != "purge" &&
     [module-info command] != "reload" } {
  puts stdout "module reload"
} 
