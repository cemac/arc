#%Module -*- tcl -*-

set module_name openmpi
set module_version 5.0.6
set module_build 1
set module_flavour intel-2025.2.0

set module_root $::env(CEMAC_SOFTWARE)/libraries/$module_name/$module_version/$module_build/$module_flavour
set module_apps $::env(CEMAC_SOFTWARE)/modulefiles/apps/$module_flavour-$module_name-$module_version
set module_libraries $::env(CEMAC_SOFTWARE)/modulefiles/libraries/$module_flavour-$module_name-$module_version

proc ModulesHelp { } {
  puts stderr "
    OpenMPI MPI library

    Homepage: https://www.open-mpi.org/
  "
}

module-whatis "MPI library"

family mpi

prepend-path PATH $module_root/bin
prepend-path CPATH $module_root/include
prepend-path LIBRARY_PATH $module_root/lib
prepend-path LD_LIBRARY_PATH $module_root/lib
prepend-path PKG_CONFIG_PATH $module_root/lib/pkgconfig
prepend-path CMAKE_PREFIX_PATH $module_root/
prepend-path MANPATH $module_root/share/man
prepend-path MODULEPATH $module_apps
prepend-path MODULEPATH $module_libraries

setenv MPI_HOME $module_root
setenv MPICC mpicc
setenv MPICXX mpic++
setenv MPIF77 mpif77
setenv MPIF90 mpif90

if { [module-info mode load] } {
  module save cemac-modules
  module purge
  module restore cemac-modules
}

if { [module-info command] != "purge" } {
  prereq intel/2025.2.0
}

if { [module-info mode unload] } {
  module unuse $module_apps
  module unuse $module_libraries
}
